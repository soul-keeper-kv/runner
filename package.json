{
  "name": "runner-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone API-first browser automation Runner Service",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:infra": "pnpm infra:up && pnpm dev",
    "dev:api": "pnpm --filter @runner/api dev",
    "dev:worker": "pnpm --filter @runner/worker dev",
    "dev:web": "pnpm --filter @runner/live-web dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "e2e": "node scripts/e2e-smoke.mjs",
    "demo:auth": "node scripts/auth-demo.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "restart": "docker compose up -d --build --force-recreate",
    "db:generate": "pnpm --filter @runner/api exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @runner/api run db:migrate",
    "contracts:check": "pnpm --filter @runner/contracts-internal run test",
    "docker:apps:stop": "docker stop runner-full-api runner-full-worker runner-full-live-web"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
