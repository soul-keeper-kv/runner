{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // The worker runs on Node, but the inspector script is serialized into the
    // page and type-checked against real DOM types. Including "dom" here is what
    // lets that script stay type-safe instead of being an untyped string.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
