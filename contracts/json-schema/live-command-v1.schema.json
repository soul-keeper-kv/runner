{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runner.local/schemas/live-command-v1.schema.json",
  "title": "LiveSessionCommandV1",
  "description": "A single realtime command sent over the live session WebSocket. Every interaction with a live browser is one of these; a client never reaches a browser API directly.",
  "type": "object",
  "required": ["id", "sessionId", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Client-generated; echoed on the result." },
    "sessionId": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "browser.navigate",
        "browser.back",
        "browser.forward",
        "browser.refresh",
        "browser.scroll",
        "selector.preview",
        "selector.validate",
        "selector.confirm",
        "selector.reject",
        "element.highlight",
        "element.pick.start",
        "element.pick.cancel",
        "element.describe",
        "registry.create-draft",
        "registry.update-draft",
        "registry.rename",
        "registry.update-description",
        "registry.update-selector",
        "registry.confirm",
        "registry.reject",
        "step.execute",
        "step.retry",
        "step.insert-before",
        "step.insert-after",
        "session.pause",
        "session.resume",
        "auth.login",
        "auth.status",
        "auth.logout",
        "state.snapshot",
        "state.inspect",
        "recording.start",
        "recording.observe",
        "recording.stop",
        "view.start",
        "view.stop"
      ]
    },
    "payload": { "type": "object" },
    "issuedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "browser.navigate" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "waitUntil": { "type": "string", "enum": ["load", "domcontentloaded", "networkidle"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "enum": ["selector.preview", "selector.validate"] } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["selector"],
            "properties": {
              "elementId": { "type": "string" },
              "selector": { "type": "object", "required": ["type"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "enum": ["registry.confirm", "registry.reject"] } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["modificationId"],
            "properties": {
              "modificationId": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "enum": ["step.execute", "step.retry"] } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["stepId"],
            "properties": { "stepId": { "type": "string" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "element.describe" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "Names the element by a viewport point (how picking works), by a selector, or by a snapshot-local runtimeId. At least one is required, so an empty payload is rejected rather than silently describing nothing.",
            "minProperties": 1,
            "properties": {
              "point": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number", "minimum": 0 },
                  "y": { "type": "number", "minimum": 0 }
                }
              },
              "selector": { "type": "object", "required": ["type"] },
              "runtimeId": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "registry.create-draft" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "A new element proposed as a draft. `systemName` is generated by the Runner from `displayName`, never supplied, because it becomes a code identifier during Page Object generation.",
            "required": ["displayName", "selector"],
            "properties": {
              "displayName": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "selector": { "type": "object", "required": ["type"] },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "selectorScore": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "registry.rename" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["elementId", "displayName"],
            "properties": {
              "elementId": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "registry.update-description" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["elementId", "description"],
            "properties": {
              "elementId": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "registry.update-selector" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["elementId", "selector"],
            "properties": {
              "elementId": { "type": "string", "minLength": 1 },
              "selector": { "type": "object", "required": ["type"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "recording.observe" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "One observed interaction. The target is named, never a selector: a recorded step only survives a UI change if it references the element by meaning.",
            "required": ["action"],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "click",
                  "dblclick",
                  "fill",
                  "select",
                  "check",
                  "uncheck",
                  "hover",
                  "press",
                  "goto"
                ]
              },
              "target": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "elementId": { "type": "string" },
                  "name": { "type": "string" },
                  "role": { "type": "string" }
                }
              },
              "value": {
                "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
              },
              "at": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "auth.login" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "Authenticates the live browser as a Runner-owned execution profile. It names a profile and nothing else: accepting a username or password here would carry a credential in a client, in a socket frame, and in every log between them.",
            "required": ["profileRef"],
            "additionalProperties": false,
            "properties": {
              "profileRef": { "type": "string", "minLength": 1 },
              "force": {
                "type": "boolean",
                "description": "Replays the login even when a stored session exists, for recovering after the application invalidated the session."
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "browser.scroll" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "Moves the live page so content outside the viewport can be seen and pointed at. Every bounding box the Runner reports is in viewport coordinates, so scrolling is what brings an element into the space a frame click can address. Exactly one of `by`, `to` or `target` is used, in the order `to`, `target`, `by`.",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "by": {
                "type": "object",
                "description": "A relative nudge, in CSS pixels — what a mouse wheel produces.",
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              },
              "to": {
                "description": "An absolute document offset. `bottom` is named rather than left to the client as a large number, because only the page knows the document height.",
                "oneOf": [
                  { "type": "string", "enum": ["top", "bottom"] },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": { "type": "number", "minimum": 0 },
                      "y": { "type": "number", "minimum": 0 }
                    }
                  }
                ]
              },
              "target": {
                "type": "object",
                "description": "Scrolls until a named element is in view. The element is named, never given as an offset: the client says which element and the page decides where it is, so a stale bbox cannot scroll to where something used to be.",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "selector": { "type": "object", "required": ["type"] },
                  "runtimeId": { "type": "string", "minLength": 1 },
                  "block": {
                    "type": "string",
                    "enum": ["start", "center", "end", "nearest"]
                  }
                }
              },
              "behavior": {
                "type": "string",
                "enum": ["auto", "smooth"],
                "description": "`auto` by default: the command resolves on the new offset, and a smooth scroll would still be moving then, so any frame captured at resolution would disagree with the boxes measured for it."
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "element.highlight" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "elementId": { "type": "string" },
              "selector": { "type": "object", "required": ["type"] },
              "durationMs": { "type": "integer", "minimum": 0, "maximum": 30000 }
            }
          }
        }
      }
    }
  ]
}
