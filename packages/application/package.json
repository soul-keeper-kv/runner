{
  "name": "@runner/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runner use cases, ports and inbound mappers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@runner/domain": "workspace:*",
    "@runner/live-protocol": "workspace:*",
    "@runner/registry-model": "workspace:*",
    "@runner/selector-model": "workspace:*",
    "@runner/shared": "workspace:*",
    "@runner/test-ir-model": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
