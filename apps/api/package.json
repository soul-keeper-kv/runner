{
  "name": "@runner/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public, versioned Runner HTTP and WebSocket API. The only supported integration surface for external services.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/infrastructure/persistence/migrate.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/websocket": "^8.3.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@runner/application": "workspace:*",
    "@runner/contracts-internal": "workspace:*",
    "@runner/domain": "workspace:*",
    "@runner/infrastructure-postgres": "workspace:*",
    "@runner/infrastructure-redis": "workspace:*",
    "@runner/live-protocol": "workspace:*",
    "@runner/registry-model": "workspace:*",
    "@runner/selector-model": "workspace:*",
    "@runner/shared": "workspace:*",
    "@runner/test-ir-model": "workspace:*",
    "bullmq": "^5.34.10",
    "drizzle-orm": "^0.38.3",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.2",
    "js-yaml": "^4.1.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
