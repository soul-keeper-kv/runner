# --- Runner API ---
RUNNER_API_PORT=3001
RUNNER_LOG_LEVEL=info
NODE_ENV=development

# --- PostgreSQL (Runner-owned persistence) ---
DATABASE_URL=postgresql://runner:runner@localhost:5433/runner

# --- Redis / BullMQ (internal only, never exposed publicly) ---
REDIS_URL=redis://localhost:6380

# --- Worker ---
RUNNER_WORKER_CONCURRENCY=2
RUNNER_BROWSER_HEADLESS=true
RUNNER_ARTIFACTS_DIR=./.runner-artifacts

# --- Live web (Vite dev) ---
VITE_RUNNER_API_URL=http://localhost:3001
VITE_RUNNER_WS_URL=ws://localhost:3001

# --- Authentication (Phase 5) ---
# Profiles are JSON and safe to commit: they reference credentials by
# environment-variable NAME, never by value.
#
# RUNNER_AUTH_PROFILES='[{"ref":"MANAGER","workspaceRef":"workspace_demo","displayName":"Store manager","strategy":"FORM_LOGIN","loginUrl":"http://localhost:8899/login","formFields":{"username":"Email","password":"Password","submit":"Sign in"},"secretRefs":{"username":"MANAGER_USER","password":"MANAGER_PASS"}}]'
#
# The credentials themselves live only in the worker's environment.
# MANAGER_USER=manager@example.com
# MANAGER_PASS=replace-me
#
# `formFields` names elements the way Test IR does — by accessible name, never
# by selector — so the login form is resolved by the same locator engine as
# everything else. The profile above matches scripts/auth-demo.mjs; run
#
#   node scripts/auth-demo.mjs
#
# to see a live session reach a page that only renders for a signed-in user.
